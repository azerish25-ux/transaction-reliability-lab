#!/usr/bin/env python3
"""Preserve every earlier gate and bind P08F requirements to executed evidence."""
import hashlib
import json
import subprocess
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
subprocess.run(['python3', 'scripts/assert-p08e-evidence'], cwd=ROOT, check=True)

def suite(relative, minimum):
    path = ROOT / relative
    if not path.is_file(): raise SystemExit(f'Missing executed suite: {relative}')
    root = ET.parse(path).getroot()
    cases = list(root.iter('testcase'))
    suites = [root] if root.tag == 'testsuite' else list(root.iter('testsuite'))
    counts = {k: sum(int(s.get(k, '0')) for s in suites) for k in ('tests','failures','errors','skipped')}
    if len(cases) < minimum or len(cases) != counts['tests'] or any(counts[k] for k in ('failures','errors','skipped')):
        raise SystemExit(f'Incomplete or failed suite {relative}: {counts}')
    if any(any(c.find(tag) is not None for tag in ('failure','error','skipped')) for c in cases):
        raise SystemExit(f'Nonpassing testcase: {relative}')
    return counts, cases, suites

client_counts, client, _ = suite('.evidence/client/p08f-results.xml', 24)
unit_counts, unit, _ = suite('backend/target/surefire-reports/TEST-lab.ledgerguard.admin.AdminFiltersTest.xml', 12)
integration_counts, integration, _ = suite('backend/target/failsafe-reports/TEST-lab.ledgerguard.AdministratorInvestigationIT.xml', 12)
browser_counts, browser, projects = suite('.evidence/playwright/junit.xml', 144)
for prefix, total, cases in [('P08FTS',24,client),('P08FUT',12,unit),('P08FIT',12,integration)]:
    for i in range(1,total+1):
        if sum(f'{prefix}{i:02}' in c.get('name','') for c in cases) != 1:
            raise SystemExit(f'Missing or duplicate {prefix}{i:02}')
for project in ('chromium-desktop','chromium-tablet','chromium-mobile'):
    matching = [s for s in projects if s.get('hostname','') == project]
    for i in range(1,11):
        if sum(f'P08FE2E{i:02}' in c.get('name','') for s in matching for c in s.findall('testcase')) != 1:
            raise SystemExit(f'Missing or duplicate {project}/P08FE2E{i:02}')
executed = {'p08f-client':client,'p08f-unit':unit,'p08f-browser':browser,'p08f-integration':integration}
manifest=json.loads((ROOT/'docs/implementation/P08F_REQUIREMENTS.json').read_text())
if not (ROOT/manifest['sourceContract']).is_file(): raise SystemExit('Missing original specification')
requirements=[]; seen=set()
for requirement in manifest['requirements']:
    if requirement['id'] in seen: raise SystemExit('Duplicate requirement')
    seen.add(requirement['id']); matches=[]
    for kind,prefixes in requirement['tests'].items():
        for prefix in prefixes:
            found=[c.get('name','') for c in executed[kind] if prefix in c.get('name','')]
            if not found: raise SystemExit(f"Missing executed mapping: {requirement['id']}/{prefix}")
            matches.extend({'suite':kind,'test':name} for name in found)
    requirements.append({**requirement,'status':'VERIFIED_PASS','executed':matches})
screens=[]
for project in ('chromium-desktop','chromium-tablet','chromium-mobile'):
    for name in ('p08f-search','p08f-detail','p08f-audit','p08f-report','p08f-failed-work'):
        path=ROOT/f'.evidence/playwright/screenshots/{project}-{name}.png'
        if not path.is_file() or path.stat().st_size<1000: raise SystemExit(f'Missing screenshot {path.name}')
        screens.append({'path':str(path.relative_to(ROOT)),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()})
if 'retries: 0' not in (ROOT/'frontend/playwright.config.ts').read_text(): raise SystemExit('Functional retries must stay zero')
source=(ROOT/'frontend/tests/e2e/p08f.spec.ts').read_text()
if "trace: 'off', video: 'off', screenshot: 'off'" not in source: raise SystemExit('Administrator investigation journeys must not automatically capture sensitive artifacts')
contract=json.loads((ROOT/'backend/src/main/resources/openapi/p08f-ui.json').read_text())
for path in ('/api/v1/admin/transactions','/api/v1/admin/transactions/{id}','/api/v1/admin/audit','/api/v1/admin/reconciliation','/api/v1/admin/reconciliation/{id}','/api/v1/admin/failed-work','/api/v1/admin/failed-work/{id}/replay'):
    if path not in contract['paths']: raise SystemExit(f'Missing P08F contract path: {path}')
for source in manifest['testSources'].values():
    if not (ROOT/source).is_file(): raise SystemExit(f'Missing mapped test source: {source}')
sha=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
if subprocess.check_output(['git','status','--porcelain','--untracked-files=no'],cwd=ROOT,text=True).strip(): raise SystemExit('Exact-SHA gate requires clean tracked sources')
report={'phase':'P08F','status':'VERIFIED_PASS','fullProductStatus':'INCOMPLETE_NO_GO','sourceSha':sha,
    'trackedTreeDirty':False,'timestamp':datetime.now(timezone.utc).isoformat(),
    'suites':{'p08f-client':client_counts,'p08f-unit':unit_counts,'p08f-integration':integration_counts,'all-browser':browser_counts},
    'p08fBrowserCases':sum('P08FE2E' in c.get('name','') for c in browser),'screenshots':screens,'requirements':requirements,
    'scope':'P01-P08E preserved; ADMIN search, connected journal/audit/failed-work investigation, consistent read-only financial checks, saved report recovery and responsive accessibility. P09-P11 and final release remain open.'}
out=ROOT/'.evidence/p08f'; out.mkdir(parents=True,exist_ok=True)
(out/'test-summary.json').write_text(json.dumps(report,indent=2)+'\n')
(out/'requirements-matrix.md').write_text('# Executed P08F requirements\n\nSource: `'+sha+'`; tracked tree clean.\n\n| Requirement | Executed cases | Status |\n|---|---:|---|\n'+'\n'.join(f"| {r['id']} | {len(r['executed'])} | VERIFIED_PASS |" for r in requirements)+'\n')
print(json.dumps({k:v for k,v in report.items() if k!='requirements'},indent=2))
print(f'Bound {len(requirements)} P08F requirements to executed evidence.')
