#!/usr/bin/env python3
"""Narrow high-signal repository secret scan; reports evidence and fails on matches."""
from __future__ import annotations
import json
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PATTERNS = {
    "private-key": re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    "github-token": re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\b"),
    "aws-access-key": re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b"),
    "slack-token": re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{20,}\b"),
}

try:
    names = subprocess.check_output(
        ["git", "-C", str(ROOT), "ls-files", "-z"], text=False, stderr=subprocess.DEVNULL
    ).split(b"\0")
    paths = [ROOT / name.decode("utf-8") for name in names if name]
except (subprocess.CalledProcessError, FileNotFoundError):
    paths = [path for path in ROOT.rglob("*") if path.is_file() and ".git" not in path.parts]

findings: list[dict[str, object]] = []
scanned = 0
for path in paths:
    if not path.is_file() or any(part in {"node_modules", "target", ".evidence", ".ledgerguard"} for part in path.parts):
        continue
    try:
        if path.stat().st_size > 2_000_000:
            continue
        text = path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        continue
    scanned += 1
    for line_number, line in enumerate(text.splitlines(), 1):
        for identifier, pattern in PATTERNS.items():
            if pattern.search(line):
                findings.append({
                    "rule": identifier,
                    "path": str(path.relative_to(ROOT)),
                    "line": line_number,
                })

result = {"status": "PASS" if not findings else "FAIL", "filesScanned": scanned, "findings": findings}
evidence = ROOT / ".evidence" / "security"
evidence.mkdir(parents=True, exist_ok=True)
(evidence / "literal-secret-scan.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
print(json.dumps(result, indent=2))
raise SystemExit(1 if findings else 0)
