#!/usr/bin/env python3
"""Render source-controlled architecture figures; no application execution."""
import json
import os
from pathlib import Path
import subprocess
import textwrap
os.environ.setdefault('MPLCONFIGDIR', '/tmp/bad-penny-matplotlib')
os.environ.setdefault('XDG_CACHE_HOME', '/tmp/bad-penny-render-cache')
Path(os.environ['XDG_CACHE_HOME']).mkdir(parents=True,exist_ok=True)
import matplotlib
matplotlib.use('Agg')
matplotlib.rcParams['svg.fonttype']='none'
matplotlib.rcParams['svg.hashsalt']='bad-penny-source-diagrams'
import matplotlib.pyplot as plt
from matplotlib.patches import FancyArrowPatch, FancyBboxPatch
ROOT=Path(__file__).resolve().parents[1]
BASE=ROOT/'docs/architecture/diagrams'
PREVIEW=ROOT/'.evidence/diagram-review'; PREVIEW.mkdir(parents=True,exist_ok=True)
for source in sorted(BASE.glob('*.dot')):
    subprocess.run(['dot','-Tsvg',str(source),'-o',str(source.with_suffix('.svg'))],check=True)
    subprocess.run(['dot','-Tpng',str(source),'-o',str(PREVIEW/(source.stem+'.png'))],check=True)
for diagram in json.loads((BASE/'sequences.json').read_text()):
    actors, messages=diagram['actors'],diagram['messages']
    fig, ax=plt.subplots(figsize=(14, max(6, len(messages)*.64+1.8)))
    fig.patch.set_facecolor('#f7f5ef');ax.set_facecolor('#f7f5ef')
    ax.set_xlim(-.55,len(actors)-.45);ax.set_ylim(len(messages)+1.3,-1.4);ax.axis('off')
    ax.text((len(actors)-1)/2,-1.12,diagram['title'],ha='center',fontsize=19,weight='bold',color='#17324a')
    for i,name in enumerate(actors):
        ax.add_patch(FancyBboxPatch((i-.4,-.55),.8,.5,boxstyle='round,pad=0.035',facecolor='white',edgecolor='#bed0d8'))
        ax.text(i,-.3,name,ha='center',va='center',fontsize=11,weight='bold',color='#17324a')
        ax.plot([i,i],[.0,len(messages)+.5],color='#bfd0d8',linestyle='--',linewidth=1)
    for number,(start,end,label) in enumerate(messages,1):
        y=number-.02
        if start == end:
            direction=-1 if start == len(actors)-1 else 1
            ax.add_patch(FancyArrowPatch((start,y-.12),(start+.18*direction,y+.2),connectionstyle='angle,angleA=0,angleB=90,rad=6',arrowstyle='-|>',mutation_scale=12,color='#347080'))
            x=start+.24*direction;align='right' if direction<0 else 'left'
        else:
            ax.add_patch(FancyArrowPatch((start,y),(end,y),arrowstyle='-|>',mutation_scale=12,color='#347080',linewidth=1.5))
            x=(start+end)/2;align='center'
        ax.text(x,y-.12,textwrap.fill(f'{number}. {label}',48),ha=align,va='bottom',fontsize=10,color='#17324a',bbox={'facecolor':'#f7f5ef','edgecolor':'none','pad':2})
    ax.text((len(actors)-1)/2,len(messages)+.95,'Synthetic money only • Source-derived behavior; this figure is not additional test evidence',ha='center',fontsize=9,color='#526d79')
    fig.tight_layout(pad=.8)
    fig.savefig(BASE/(diagram['id']+'.svg'),metadata={'Date':None})
    fig.savefig(PREVIEW/(diagram['id']+'.png'),dpi=130)
    plt.close(fig)
print('Rendered 7 source-derived diagrams; previews in .evidence/diagram-review')
