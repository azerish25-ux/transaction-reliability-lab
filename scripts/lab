#!/usr/bin/env python3
"""LedgerGuard deterministic developer and CI control surface."""
from __future__ import annotations
import base64
import fcntl
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / ".ledgerguard"
ENV_FILE = STATE / "runtime.env"
EVIDENCE = ROOT / ".evidence"
COMPOSE = ROOT / "compose.yaml"

HELP = """LedgerGuard — synthetic-money reliability laboratory
Implemented commands:
  ./scripts/lab help
  ./scripts/lab doctor
  ./scripts/lab up
  ./scripts/lab down
  ./scripts/lab logs
  ./scripts/lab status
  ./scripts/lab test unit
  ./scripts/lab test ui
  ./scripts/lab test e2e
  ./scripts/lab test database
  ./scripts/lab test auth
  ./scripts/lab test transfer
  ./scripts/lab test payment
  ./scripts/lab test adjustment
  ./scripts/lab test pr
  ./scripts/lab reconcile
  ./scripts/lab evidence
  ./scripts/lab up --lab
  ./scripts/lab down --lab
  ./scripts/lab down --lab --reset-data
  ./scripts/lab status --lab
  ./scripts/lab resilience F01
  ./scripts/lab defect D02
  ./scripts/lab defects --all
  ./scripts/lab test p09a-unit
  ./scripts/lab test p09a

P01–P08F have retained exact-source milestone evidence. P09A adds an opt-in,
disposable F01/D02 laboratory. Implementation is not a verified release.
The complete P09 catalogue and P10–P11 remain open; --all fails when incomplete.
"""

def run(command: list[str], *, check: bool = True, capture: bool = False, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=ROOT, check=check, text=True, input=input_text, capture_output=capture)

def docker_ready() -> bool:
    if not shutil.which("docker"): return False
    try: return run(["docker", "info"], check=False, capture=True).returncode == 0
    except OSError: return False

def compose_available() -> bool:
    if not shutil.which("docker"): return False
    try: return run(["docker", "compose", "version"], check=False, capture=True).returncode == 0
    except OSError: return False

def read_environment() -> dict[str, str]:
    values: dict[str, str] = {}
    if ENV_FILE.exists():
        for raw in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if raw and not raw.startswith("#") and "=" in raw:
                key, value = raw.split("=", 1); values[key] = value
    return values

def ensure_environment() -> dict[str, str]:
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700); STATE.chmod(0o700)
    with (STATE / "environment.lock").open("a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX); values = read_environment()
        defaults = {
            "COMPOSE_PROJECT_NAME":"ledgerguard",
            "POSTGRES_DB":"ledgerguard",
            "POSTGRES_SUPERUSER_PASSWORD":secrets.token_hex(32),
            "LEDGER_OWNER_PASSWORD":secrets.token_hex(32),
            "LEDGER_RUNTIME_PASSWORD":secrets.token_hex(32),
            "RABBITMQ_DEFAULT_USER":"ledgerguard",
            "RABBITMQ_DEFAULT_PASS":secrets.token_hex(32),
            "RABBITMQ_DEFAULT_VHOST":"/ledgerguard",
            "LEDGER_HTTP_PORT":"8080",
            "LEDGER_UI_PORT":"3000",
            "LEDGER_RABBIT_MANAGEMENT_PORT":"15672",
            "LEDGER_AUTH_KEY":base64.b64encode(secrets.token_bytes(64)).decode("ascii"),
            "LEDGER_DEMO_PASSWORD":secrets.token_urlsafe(24)
        }
        changed=False
        for key,value in defaults.items():
            if key not in values: values[key]=value; changed=True
        if changed:
            temporary=None
            try:
                with tempfile.NamedTemporaryFile(mode="w",encoding="utf-8",dir=STATE,delete=False) as output:
                    temporary=Path(output.name); os.fchmod(output.fileno(),0o600)
                    output.write("".join(f"{key}={value}\n" for key,value in values.items())); output.flush(); os.fsync(output.fileno())
                os.replace(temporary,ENV_FILE)
            finally:
                if temporary is not None: temporary.unlink(missing_ok=True)
        ENV_FILE.chmod(0o600); return values

def api_base_url() -> str: return f"http://127.0.0.1:{ensure_environment().get('LEDGER_HTTP_PORT','8080')}"
def ui_base_url() -> str: return f"http://127.0.0.1:{ensure_environment().get('LEDGER_UI_PORT','3000')}"
def compose(*arguments: str, check: bool = True, capture: bool = False, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    ensure_environment(); return run(["docker","compose","--env-file",str(ENV_FILE),"-f",str(COMPOSE),*arguments],check=check,capture=capture,input_text=input_text)
def get_json(url: str, timeout: float = 3.0) -> dict[str, object]:
    request=urllib.request.Request(url,headers={"Accept":"application/json","User-Agent":"LedgerGuard-lab"})
    with urllib.request.urlopen(request,timeout=timeout) as response: return json.loads(response.read().decode("utf-8"))
def get_text(url: str, timeout: float = 3.0) -> str:
    request=urllib.request.Request(url,headers={"Accept":"text/plain","User-Agent":"LedgerGuard-lab"})
    with urllib.request.urlopen(request,timeout=timeout) as response: return response.read().decode("utf-8")
def wait_for_readiness(seconds: int = 210) -> dict[str, object]:
    deadline=time.monotonic()+seconds; latest="not attempted"; base=api_base_url()
    while time.monotonic()<deadline:
        try:
            health=get_json(f"{base}/actuator/health/readiness"); system=get_json(f"{base}/api/v1/system")
            if health.get("status")=="UP" and system.get("databaseRole")=="ledger_runtime": return system
            latest=f"health={health!r} system={system!r}"
        except (urllib.error.URLError,OSError,json.JSONDecodeError) as failure: latest=f"{type(failure).__name__}: {failure}"
        time.sleep(2)
    raise RuntimeError(f"LedgerGuard API did not become ready: {latest}")
def wait_for_ui(seconds: int = 90) -> None:
    deadline=time.monotonic()+seconds; latest="not attempted"; base=ui_base_url()
    while time.monotonic()<deadline:
        try:
            if get_text(f"{base}/healthz").strip()=="ok": return
            latest="unexpected health response"
        except (urllib.error.URLError,OSError) as failure: latest=f"{type(failure).__name__}: {failure}"
        time.sleep(1)
    raise RuntimeError(f"LedgerGuard UI did not become ready: {latest}")
def reconcile() -> None:
    values=ensure_environment(); sql=(ROOT/"tests/database/reconcile.sql").read_text(encoding="utf-8")
    compose("exec","-T","-e",f"PGPASSWORD={values['LEDGER_OWNER_PASSWORD']}","postgres","psql","-X","-v","ON_ERROR_STOP=1","-h","127.0.0.1","-U","ledger_owner","-d",values["POSTGRES_DB"],input_text=sql)
def capture_logs() -> None:
    if not ENV_FILE.exists() or not compose_available(): return
    target=EVIDENCE/"compose"; target.mkdir(parents=True,exist_ok=True); result=compose("logs","--no-color",check=False,capture=True); (target/"services.log").write_text((result.stdout or "")+(result.stderr or ""),encoding="utf-8")
def command_doctor() -> int:
    facts={name:shutil.which(name) for name in ["java","javac","node","npm","git","docker","curl"]}; facts["docker_compose"]=compose_available(); facts["docker_daemon"]=docker_ready(); result={"status":"READY" if facts["docker_compose"] and facts["docker_daemon"] else "BLOCKED","tools":facts}; print(json.dumps(result,indent=2)); return 0 if result["status"]=="READY" else 2
def command_up() -> int:
    if not compose_available() or not docker_ready(): print("BLOCKED: Docker Engine and Docker Compose are required.",file=sys.stderr); return 2
    ensure_environment()
    try:
        compose("up","-d","--build","--wait","postgres","rabbitmq","api","web","outbox-publisher","payment-worker-a","payment-worker-b")
        system=wait_for_readiness(); compose("run","--rm","seed"); reconcile(); wait_for_ui()
    except (subprocess.CalledProcessError,RuntimeError) as failure:
        capture_logs(); print(f"STARTUP FAILED: {failure}",file=sys.stderr); return 1
    base=api_base_url(); ui=ui_base_url()
    print("LedgerGuard base topology is ready (synthetic money only; no real financial services).")
    print(f"Product UI: {ui}")
    print(f"API health: {base}/actuator/health/readiness")
    print(f"System boundary: {base}/api/v1/system")
    print(f"P08F scoped OpenAPI: {base}/api/v1/openapi/p08f-ui.json")
    print(f"Database runtime role: {system.get('databaseRole')}")
    print("Sandbox identities: alice@example.test, bob@example.test, merchant@example.test, admin@example.test.")
    print("Their generated password is LEDGER_DEMO_PASSWORD in private .ledgerguard/runtime.env; it is not printed in CI logs.")
    print("The UI acquires and rotates CSRF automatically. Money commands require a stable Idempotency-Key.")
    return 0
def command_down() -> int:
    if not ENV_FILE.exists() or not compose_available(): print("LedgerGuard environment is not initialized."); return 0
    capture_logs(); return compose("down","--remove-orphans",check=False).returncode
def command_status() -> int:
    if not ENV_FILE.exists() or not compose_available(): print("LedgerGuard environment is not initialized."); return 2
    compose("ps")
    try:
        base=api_base_url(); ui=ui_base_url()
        print(json.dumps({"readiness":get_json(f"{base}/actuator/health/readiness"),"system":get_json(f"{base}/api/v1/system"),"ui":get_text(f"{ui}/healthz").strip()},indent=2)); return 0
    except (urllib.error.URLError,OSError,json.JSONDecodeError) as failure: print(f"Application not ready: {failure}",file=sys.stderr); return 1
def maven_verify(test: str | None = None) -> int:
    command=["./mvnw","-B","-ntp","-f","backend/pom.xml"]
    if test: command.append(f"-Dit.test={test}")
    command.append("verify"); return run(command,check=False).returncode
def frontend_verify() -> int:
    install=run(["npm","ci","--prefix","frontend"],check=False)
    if install.returncode: return install.returncode
    return run(["npm","--prefix","frontend","run","verify"],check=False).returncode
def playwright_install() -> int:
    return run(["npm","exec","--prefix","frontend","--","playwright","install","chromium"],check=False).returncode
def command_test(target: str) -> int:
    if target=="unit":
        for executable in ["./scripts/test-core","./scripts/test-client"]:
            result=run([executable],check=False)
            if result.returncode: return result.returncode
        return 0
    if target=="ui": return frontend_verify()
    if target in {"pr", "e2e"}:
        if not docker_ready(): print("BLOCKED: product verification requires Docker.",file=sys.stderr); return 2
        return run([sys.executable, "scripts/verify-product", target], check=False).returncode
    if target == "p09a-unit":
        return run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p", "test_p09a*.py", "-v"], check=False).returncode
    if target == "p09a":
        return run([sys.executable, "lab-support/p09a/cli.py", "verify"], check=False).returncode
    if target in {"database","auth","transfer","payment","adjustment"}:
        if not docker_ready(): print("BLOCKED: a working Docker daemon is required by Testcontainers.",file=sys.stderr); return 2
        return maven_verify({"database":None,"auth":"AuthenticationAccountsIT","transfer":"TransferReliabilityIT","payment":"TransferReliabilityIT","adjustment":"PaymentAdjustmentReliabilityIT"}[target])
    print(f"BLOCKED / NOT_STARTED: test lane {target!r} is not implemented.",file=sys.stderr); return 2
def main() -> int:
    args=sys.argv[1:]
    if not args or args[0] in {"help","--help","-h"}: print(HELP); return 0
    if args in (["up", "--lab"], ["down", "--lab"], ["status", "--lab"]):
        return run([sys.executable, "lab-support/p09a/cli.py", args[0]], check=False).returncode
    if args == ["down", "--lab", "--reset-data"]:
        return run([sys.executable, "lab-support/p09a/cli.py", "down", "--reset-data"], check=False).returncode
    if args[0] in {"defect", "defects", "resilience"}:
        return run([sys.executable, "lab-support/p09a/cli.py", *args], check=False).returncode
    if args==["doctor"]: return command_doctor()
    if args==["up"]: return command_up()
    if args==["down"]: return command_down()
    if args==["logs"]: capture_logs(); print(EVIDENCE/"compose"/"services.log"); return 0
    if args==["status"]: return command_status()
    if len(args)==2 and args[0]=="test": return command_test(args[1])
    if args==["reconcile"]:
        if not docker_ready(): print("BLOCKED: reconciliation requires the running Compose database.",file=sys.stderr); return 2
        reconcile(); return 0
    if args==["evidence"]: return run(["./scripts/validate-evidence"],check=False).returncode
    if args[0] in {"performance","demo"}: print("BLOCKED / NOT_STARTED: this belongs to a later implementation phase.",file=sys.stderr); return 2
    print("Unknown command.\n"+HELP,file=sys.stderr); return 2
if __name__=="__main__": raise SystemExit(main())
