#!/usr/bin/env python3
"""LedgerGuard deterministic developer and CI control surface."""
from __future__ import annotations
import json
import secrets
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / ".ledgerguard"
ENV_FILE = STATE / "runtime.env"
EVIDENCE = ROOT / ".evidence"
COMPOSE = ROOT / "compose.yaml"

HELP = """LedgerGuard — synthetic-money reliability laboratory
Implemented foundation commands:
  ./scripts/lab help
  ./scripts/lab doctor
  ./scripts/lab up
  ./scripts/lab down
  ./scripts/lab logs
  ./scripts/lab status
  ./scripts/lab test unit
  ./scripts/lab test database
  ./scripts/lab test pr
  ./scripts/lab reconcile
  ./scripts/lab evidence

Later product/laboratory phases remain explicit blockers: test nightly/release,
defect(s), resilience, performance and demo.
"""


def run(command: list[str], *, check: bool = True, capture: bool = False, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=ROOT,
        check=check,
        text=True,
        input=input_text,
        capture_output=capture,
    )


def docker_ready() -> bool:
    if not shutil.which("docker"):
        return False
    try:
        return run(["docker", "info"], check=False, capture=True).returncode == 0
    except OSError:
        return False


def compose_available() -> bool:
    if not shutil.which("docker"):
        return False
    try:
        return run(["docker", "compose", "version"], check=False, capture=True).returncode == 0
    except OSError:
        return False


def ensure_environment() -> dict[str, str]:
    STATE.mkdir(parents=True, exist_ok=True)
    if not ENV_FILE.exists():
        values = {
            "COMPOSE_PROJECT_NAME": "ledgerguard",
            "POSTGRES_DB": "ledgerguard",
            "POSTGRES_SUPERUSER_PASSWORD": secrets.token_hex(32),
            "LEDGER_OWNER_PASSWORD": secrets.token_hex(32),
            "LEDGER_RUNTIME_PASSWORD": secrets.token_hex(32),
            "RABBITMQ_DEFAULT_USER": "ledgerguard",
            "RABBITMQ_DEFAULT_PASS": secrets.token_hex(32),
            "RABBITMQ_DEFAULT_VHOST": "/ledgerguard",
            "LEDGER_HTTP_PORT": "8080",
            "LEDGER_RABBIT_MANAGEMENT_PORT": "15672",
        }
        ENV_FILE.write_text("".join(f"{key}={value}\n" for key, value in values.items()), encoding="utf-8")
        ENV_FILE.chmod(0o600)
    return read_environment()


def read_environment() -> dict[str, str]:
    values: dict[str, str] = {}
    if ENV_FILE.exists():
        for raw in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if raw and not raw.startswith("#") and "=" in raw:
                key, value = raw.split("=", 1)
                values[key] = value
    return values


def api_base_url() -> str:
    values = ensure_environment()
    return f"http://127.0.0.1:{values.get('LEDGER_HTTP_PORT', '8080')}"


def compose(*arguments: str, check: bool = True, capture: bool = False, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    ensure_environment()
    command = ["docker", "compose", "--env-file", str(ENV_FILE), "-f", str(COMPOSE), *arguments]
    return run(command, check=check, capture=capture, input_text=input_text)


def get_json(url: str, timeout: float = 3.0) -> dict[str, object]:
    request = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": "LedgerGuard-lab"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def wait_for_readiness(seconds: int = 210) -> dict[str, object]:
    deadline = time.monotonic() + seconds
    latest = "not attempted"
    base = api_base_url()
    while time.monotonic() < deadline:
        try:
            health = get_json(f"{base}/actuator/health/readiness")
            system = get_json(f"{base}/api/v1/system")
            if health.get("status") == "UP" and system.get("databaseRole") == "ledger_runtime":
                return system
            latest = f"health={health!r} system={system!r}"
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as failure:
            # A newly started JVM can accept and reset an early socket before the
            # HTTP server is ready. Treat all connection-level startup failures as
            # transient until the bounded readiness deadline expires.
            latest = f"{type(failure).__name__}: {failure}"
        time.sleep(2)
    raise RuntimeError(f"LedgerGuard did not become ready: {latest}")


def reconcile() -> None:
    values = ensure_environment()
    sql = (ROOT / "tests/database/reconcile.sql").read_text(encoding="utf-8")
    command = [
        "exec", "-T", "-e", f"PGPASSWORD={values['LEDGER_OWNER_PASSWORD']}",
        "postgres", "psql", "-X", "-v", "ON_ERROR_STOP=1", "-h", "127.0.0.1",
        "-U", "ledger_owner", "-d", values["POSTGRES_DB"],
    ]
    compose(*command, input_text=sql)


def capture_logs() -> None:
    if not ENV_FILE.exists() or not compose_available():
        return
    target = EVIDENCE / "compose"
    target.mkdir(parents=True, exist_ok=True)
    result = compose("logs", "--no-color", check=False, capture=True)
    (target / "services.log").write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")


def command_doctor() -> int:
    facts = {name: shutil.which(name) for name in ["java", "javac", "node", "npm", "git", "docker", "curl"]}
    facts["docker_compose"] = compose_available()
    facts["docker_daemon"] = docker_ready()
    result = {"status": "READY" if facts["docker_compose"] and facts["docker_daemon"] else "BLOCKED", "tools": facts}
    print(json.dumps(result, indent=2))
    return 0 if result["status"] == "READY" else 2


def command_up() -> int:
    if not compose_available() or not docker_ready():
        print("BLOCKED: Docker Engine and Docker Compose are required.", file=sys.stderr)
        return 2
    ensure_environment()
    try:
        compose("up", "-d", "--build", "postgres", "rabbitmq", "api")
        system = wait_for_readiness()
        compose("run", "--rm", "seed")
        reconcile()
    except (subprocess.CalledProcessError, RuntimeError) as failure:
        capture_logs()
        print(f"STARTUP FAILED: {failure}", file=sys.stderr)
        return 1
    base = api_base_url()
    management_port = ensure_environment().get("LEDGER_RABBIT_MANAGEMENT_PORT", "15672")
    print("LedgerGuard foundation is ready (synthetic money only).")
    print(f"API health: {base}/actuator/health/readiness")
    print(f"System boundary: {base}/api/v1/system")
    print(f"RabbitMQ management: http://127.0.0.1:{management_port}")
    print(f"Database runtime role: {system.get('databaseRole')}")
    print("Authentication/UI are intentionally not claimed in this P01/P02 milestone.")
    return 0


def command_down() -> int:
    if not ENV_FILE.exists() or not compose_available():
        print("LedgerGuard environment is not initialized.")
        return 0
    capture_logs()
    return compose("down", "--remove-orphans", check=False).returncode


def command_status() -> int:
    if not ENV_FILE.exists() or not compose_available():
        print("LedgerGuard environment is not initialized.")
        return 2
    compose("ps")
    base = api_base_url()
    try:
        print(json.dumps({
            "readiness": get_json(f"{base}/actuator/health/readiness"),
            "system": get_json(f"{base}/api/v1/system"),
        }, indent=2))
        return 0
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as failure:
        print(f"API not ready: {failure}", file=sys.stderr)
        return 1


def command_test(target: str) -> int:
    if target == "unit":
        for executable in ["./scripts/test-core", "./scripts/test-client"]:
            result = run([executable], check=False)
            if result.returncode:
                return result.returncode
        return 0
    if target == "database":
        if not docker_ready():
            print("BLOCKED: a working Docker daemon is required by Testcontainers.", file=sys.stderr)
            return 2
        return run(["./mvnw", "-B", "-ntp", "-f", "backend/pom.xml", "verify"], check=False).returncode
    if target == "pr":
        if not docker_ready():
            print("BLOCKED: PR verification requires Docker.", file=sys.stderr)
            return 2
        commands = [
            ["npm", "ci", "--prefix", "frontend"],
            ["./scripts/lab", "test", "unit"],
            ["./mvnw", "-B", "-ntp", "-f", "backend/pom.xml", "verify"],
            ["./scripts/scan-secrets"],
            ["docker", "compose", "--env-file", ".env.example", "-f", "compose.yaml", "config", "--quiet"],
        ]
        for command in commands:
            result = run(command, check=False)
            if result.returncode:
                return result.returncode
        return 0
    print(f"BLOCKED / NOT_STARTED: test lane {target!r} is not implemented.", file=sys.stderr)
    return 2


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"help", "--help", "-h"}:
        print(HELP)
        return 0
    if args == ["doctor"]:
        return command_doctor()
    if args == ["up"]:
        return command_up()
    if args == ["down"]:
        return command_down()
    if args == ["logs"]:
        capture_logs()
        print(EVIDENCE / "compose" / "services.log")
        return 0
    if args == ["status"]:
        return command_status()
    if len(args) == 2 and args[0] == "test":
        return command_test(args[1])
    if args == ["reconcile"]:
        if not docker_ready():
            print("BLOCKED: reconciliation requires the running Compose database.", file=sys.stderr)
            return 2
        reconcile()
        return 0
    if args == ["evidence"]:
        return run(["./scripts/validate-evidence"], check=False).returncode
    if args[0] in {"defect", "defects", "resilience", "performance", "demo"}:
        print("BLOCKED / NOT_STARTED: this belongs to a later implementation phase.", file=sys.stderr)
        return 2
    print("Unknown command.\n" + HELP, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
