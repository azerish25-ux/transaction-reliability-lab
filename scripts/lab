#!/usr/bin/env python3
"""LedgerGuard command surface. Unsupported work fails explicitly; nothing is marked complete by omission."""
import argparse, json, shutil, subprocess, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parent.parent
HELP='''LedgerGuard — INCOMPLETE / NO_GO
Implemented commands:
  ./scripts/lab help                  Show actual command availability
  ./scripts/lab doctor                Inspect execution prerequisites
  ./scripts/lab status                Show recorded delivery/release state
  ./scripts/lab test unit             Standalone Java + Node client-unit tests (NOT full CI)
  ./scripts/lab test database         Real PostgreSQL/JUnit/Testcontainers source suite, requires Maven/Docker
  ./scripts/lab unit-probes D12       One isolated component mutation, NOT a full-stack Dxx experiment
  ./scripts/lab unit-probes --all     All implemented component probes
  ./scripts/lab evidence             Validate existing evidence, hashes and requirement links

Not implemented/verified: up, down, test pr/nightly/release, full-stack defect(s),
resilience, performance, reconcile service, demo/video, public deployment.
Those commands return a nonzero blocker, never an artificial PASS.
'''
def invoke(args):return subprocess.call(args,cwd=ROOT)
args=sys.argv[1:]
if not args or args[0] in ['help','--help','-h']:print(HELP);sys.exit(0)
if args[0]=='doctor':
    facts={tool:shutil.which(tool) for tool in ['java','javac','node','npm','tsc','mvn','git','docker','psql','chromium','ffmpeg']}
    if facts['docker']:
        check=subprocess.run(['docker','info'],capture_output=True,text=True,timeout=10);facts['docker_daemon_available']=check.returncode==0
    else:facts['docker_daemon_available']=False
    print(json.dumps({'status':'INCOMPLETE','tools':facts,'full_application_startup_verified':False},indent=2));sys.exit(0 if facts['mvn'] and facts['docker_daemon_available'] else 2)
if args[0]=='status':
    path=ROOT/'docs/implementation/RELEASE_READINESS.md';print(path.read_text() if path.exists() else 'INCOMPLETE / NO_GO — readiness report not generated.');sys.exit(0)
if args==['test','unit']:
    for command in ['./scripts/test-core','./scripts/test-client']:
        code=invoke([command])
        if code:sys.exit(code)
    sys.exit(0)
if args==['test','database']:
    if not shutil.which('mvn') or not shutil.which('docker'):print('BLOCKED: Maven and a working Docker environment are required for real PostgreSQL tests.',file=sys.stderr);sys.exit(2)
    sys.exit(invoke(['mvn','-B','-f','backend/pom.xml','verify']))
if args[0]=='unit-probes':sys.exit(invoke(['./scripts/unit-probes',*args[1:]]))
if args==['evidence']:
    if not (ROOT/'scripts/validate-evidence').exists():print('BLOCKED: evidence validator not present.',file=sys.stderr);sys.exit(2)
    sys.exit(invoke(['./scripts/validate-evidence']))
if args[0] in ['up','down','defect','defects','resilience','performance','reconcile','demo','test']:
    print('BLOCKED / INCOMPLETE: this product/full-stack verification command is not implemented. See docs/implementation/PROGRESS.md.',file=sys.stderr);sys.exit(2)
print('Unknown command. '+HELP,file=sys.stderr);sys.exit(2)
