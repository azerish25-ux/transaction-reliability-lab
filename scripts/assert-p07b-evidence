#!/usr/bin/env python3
"""Require verified P01-P07A regression plus executed P07B webhook evidence."""
import json
import subprocess
import xml.etree.ElementTree as ET
from datetime import datetime,timezone
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent
subprocess.run(["python3","scripts/assert-p07a-evidence"],cwd=ROOT,check=True)

executed={}
rows=[]
for relative,suite_name,minimum in (
    (".evidence/core/results.xml","CoreTest",120),
    ("backend/target/failsafe-reports/TEST-lab.ledgerguard.WebhookDeliveryReliabilityIT.xml","WebhookDeliveryReliabilityIT",5),
    (".evidence/client/webhook-results.xml","webhook-client",7),
):
    path=ROOT/relative
    if not path.is_file(): raise SystemExit(f"Missing P07B test result: {relative}")
    suite=ET.parse(path).getroot()
    counts={key:int(suite.get(key,"0")) for key in ("tests","failures","errors","skipped")}
    cases=suite.findall(".//testcase")
    if counts["tests"]<minimum or len(cases)!=counts["tests"]:
        raise SystemExit(f"Missing expected discovery: {relative}: {counts}, cases={len(cases)}")
    if any(counts[key] for key in ("failures","errors","skipped")):
        raise SystemExit(f"P07B suite did not pass without skips: {relative}: {counts}")
    for case in cases:
        if any(case.find(tag) is not None for tag in ("failure","error","skipped")):
            raise SystemExit(f"Non-passing P07B test case: {relative}: {case.get('name')}")
    executed[suite_name]=[case.get("name","") for case in cases]
    rows.append({"suite":relative,**counts})

compose_path=ROOT/".evidence/webhook-compose/results.json"
if not compose_path.is_file(): raise SystemExit("Missing real P07B Compose evidence")
compose=json.loads(compose_path.read_text(encoding="utf-8"))
if not compose.get("checks") or any(item.get("status")!="PASS" for item in compose["checks"]):
    raise SystemExit("P07B Compose evidence contains non-passing checks")
executed["webhook-compose"]=[item["test"] for item in compose["checks"]]
rows.append({"suite":str(compose_path.relative_to(ROOT)),"tests":len(executed["webhook-compose"]),
             "failures":0,"errors":0,"skipped":0})

def match(prefix,name):
    return name==prefix or name.startswith(prefix+"_") or name.startswith(prefix+"-") \
        or name.startswith(prefix+"[")

manifest=json.loads((ROOT/"docs/implementation/P07B_REQUIREMENTS.json").read_text(encoding="utf-8"))
if not (ROOT/manifest["sourceContract"]).is_file(): raise SystemExit("Missing P07B source contract")
traceability=[];seen=set()
for requirement in manifest["requirements"]:
    identity=requirement["id"]
    if identity in seen: raise SystemExit(f"Duplicate P07B requirement: {identity}")
    seen.add(identity);matches=[]
    for suite_name,prefixes in requirement["tests"].items():
        for prefix in prefixes:
            actual=[name for name in executed.get(suite_name,[]) if match(prefix,name)]
            if not actual: raise SystemExit(f"No executed oracle for {identity}: {suite_name}/{prefix}")
            matches.extend({"suite":suite_name,"test":name} for name in actual)
    traceability.append({"id":identity,"phase":manifest["phase"],"statement":requirement["statement"],
                         "status":"VERIFIED_PASS","tests":matches})

spec=json.loads((ROOT/"backend/src/main/resources/openapi/p07b-webhooks.json").read_text(encoding="utf-8"))
for path in ("/api/v1/webhook-endpoints","/api/v1/webhook-endpoints/{id}",
             "/api/v1/webhook-endpoints/{id}/state","/api/v1/webhook-endpoints/{id}/rotate-secret",
             "/api/v1/webhook-endpoints/{id}/deliveries","/api/v1/webhook-deliveries/{id}",
             "/api/v1/webhook-deliveries/{id}/retry","/api/v1/admin/webhook-deliveries",
             "/api/v1/admin/webhook-deliveries/{id}",
             "/api/v1/admin/webhook-deliveries/{id}/retry","/events"):
    if path not in spec["paths"]: raise SystemExit(f"P07B OpenAPI missing {path}")

def validate_refs(value):
    if isinstance(value,dict):
        ref=value.get("$ref")
        if ref:
            if not ref.startswith("#/"): raise SystemExit(f"Unexpected external OpenAPI reference: {ref}")
            target=spec
            for part in ref[2:].split("/"):
                target=target[part.replace("~1","/").replace("~0","~")]
        for child in value.values(): validate_refs(child)
    elif isinstance(value,list):
        for child in value: validate_refs(child)
validate_refs(spec)

for relative in (
    "backend/src/main/resources/db/p07b/V10__p07b_signed_durable_webhooks.sql",
    "backend/src/main/java/lab/ledgerguard/auth/HttpRequestBoundary.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookSettings.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookRepository.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookService.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookController.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/AdminWebhookController.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookDispatcher.java",
    "backend/src/main/java/lab/ledgerguard/webhooks/WebhookReceiverController.java",
    "backend/src/test/java/lab/ledgerguard/WebhookDeliveryReliabilityIT.java",
    "frontend/src/webhook-api.ts",
    "tests/contracts/webhook-client.test.cjs",
    "compose.p07.yaml",
    "scripts/smoke-webhooks",
):
    if not (ROOT/relative).is_file(): raise SystemExit(f"Missing P07B implementation source: {relative}")

sha=subprocess.check_output(["git","rev-parse","HEAD"],cwd=ROOT,text=True).strip()
dirty=bool(subprocess.check_output(["git","status","--porcelain","--untracked-files=no"],cwd=ROOT,text=True).strip())
report={"sourceSha":sha,"trackedTreeDirty":dirty,"timestamp":datetime.now(timezone.utc).isoformat(),
        "status":"VERIFIED_PASS","suites":rows,"requirements":traceability,
        "scope":"P01-P07A regression plus P07B encrypted endpoint secrets, exact-byte HMAC receiver, durable fan-out, two-dispatcher claims, bounded retry/restart/manual-retry and financial-isolation proofs; P08-P11 remain incomplete"}
out=ROOT/".evidence/p07b";out.mkdir(parents=True,exist_ok=True)
(out/"test-summary.json").write_text(json.dumps(report,indent=2)+"\n",encoding="utf-8")
matrix=["# Executed P07B requirements","",f"Source: `{sha}`; tracked tree dirty: `{dirty}`.","",
        "| Requirement | Executed cases/checks | Result |","|---|---:|---|"]
for item in traceability: matrix.append(f"| {item['id']} | {len(item['tests'])} | {item['status']} |")
matrix.extend(["","Exact case/check names and source identity are in test-summary.json."])
(out/"requirements-matrix.md").write_text("\n".join(matrix)+"\n",encoding="utf-8")
print(json.dumps({key:value for key,value in report.items() if key!="requirements"},indent=2))
print(f"Verified {len(traceability)} P07B requirements against executed evidence.")
