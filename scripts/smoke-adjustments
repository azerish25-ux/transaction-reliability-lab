#!/usr/bin/env python3
"""Live Compose P06 smoke for cancellation, refunds, reversal and adjustment invariants."""
from __future__ import annotations
import http.cookiejar
import json
import secrets
import subprocess
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent
ENV=ROOT/".ledgerguard/runtime.env"
VALUES=dict(line.split("=",1) for line in ENV.read_text().splitlines() if line and not line.startswith("#"))
BASE="http://127.0.0.1:"+VALUES.get("LEDGER_HTTP_PORT","8080")+"/api/v1"
COMPOSE=["docker","compose","--env-file",str(ENV),"-f",str(ROOT/"compose.yaml")]

class Browser:
    def __init__(self):
        self.jar=http.cookiejar.CookieJar()
        self.opener=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.jar))
        self.token=None
    def call(self,path,body=None,method=None,headers=None):
        request_headers={"Accept":"application/json",**(headers or {})}
        if self.token: request_headers["X-XSRF-TOKEN"]=self.token
        data=None
        if body is not None:
            request_headers["Content-Type"]="application/json"
            data=json.dumps(body,separators=(",",":")).encode()
        request=urllib.request.Request(BASE+path,data=data,headers=request_headers,
            method=method or ("POST" if body is not None else "GET"))
        try: response=self.opener.open(request,timeout=20)
        except urllib.error.HTTPError as error: response=error
        with response:
            raw=response.read()
            return response.status,json.loads(raw) if raw else None,dict(response.headers.items())
    def csrf(self):
        status,body,_=self.call("/auth/csrf")
        assert status==200,(status,body)
        self.token=body["token"]
    def register_login(self,label):
        self.csrf()
        email=f"p06-{uuid.uuid4().hex}@example.test"
        password="P06-"+secrets.token_urlsafe(24)
        status,registered,_=self.call("/auth/register",{"email":email,"password":password,"displayName":label})
        assert status==201,(status,registered)
        status,session,_=self.call("/auth/login",{"email":email,"password":password})
        assert status==200,(status,session)
        self.csrf()
        return registered
    def login(self,email,password):
        self.csrf()
        status,session,_=self.call("/auth/login",{"email":email,"password":password})
        assert status==200,(status,session)
        self.csrf()
        return session

def compose(*args,check=True,capture=False):
    return subprocess.run([*COMPOSE,*args],cwd=ROOT,text=True,check=check,capture_output=capture)

def sql(query):
    result=compose("exec","-T","-e",f"PGPASSWORD={VALUES['LEDGER_OWNER_PASSWORD']}","postgres",
        "psql","-X","-A","-t","-q","-v","ON_ERROR_STOP=1","-U","ledger_owner",
        "-d",VALUES["POSTGRES_DB"],"-c",query,capture=True)
    return result.stdout.strip()

def wait_sql(query,expected,seconds=60):
    deadline=time.monotonic()+seconds;latest=None
    while time.monotonic()<deadline:
        latest=sql(query)
        if latest==str(expected):return latest
        time.sleep(.4)
    raise AssertionError(f"SQL condition did not reach {expected!r}; last={latest!r}; query={query}")

def wait_payment(browser,payment_id,state,seconds=60):
    deadline=time.monotonic()+seconds; latest=None
    while time.monotonic()<deadline:
        status,latest,_=browser.call("/payments/"+payment_id)
        if status==200 and latest["state"]==state:return latest
        time.sleep(.4)
    raise AssertionError(f"Payment {payment_id} did not reach {state}; last={latest}")

def check(name,condition):
    if not condition:raise AssertionError(name)
    checks.append({"test":name,"status":"PASS"})

def key(prefix):return prefix+"-"+uuid.uuid4().hex

def account(browser,name):
    status,body,_=browser.call("/accounts",{"name":name,"currency":"CAD"})
    assert status==201,(status,body)
    return body

def fund(account_id,amount):
    asset=str(uuid.uuid4());operation=str(uuid.uuid4())
    sql(f"BEGIN; INSERT INTO ledger.accounts(id,label,currency,kind) VALUES('{asset}','P06 synthetic asset','CAD','SANDBOX_FUNDING_ASSET'); "
        f"INSERT INTO ledger.account_balances(account_id) VALUES('{asset}'); "
        f"SELECT ledger._post('{operation}','FUNDING','{asset}','{account_id}',{amount},'CAD'); COMMIT;")

def payment(browser,source,recipient,amount,command_key):
    return browser.call("/payments",{"sourceId":source,"recipientRef":recipient,"amountMinor":str(amount),"currency":"CAD"},
        headers={"Idempotency-Key":command_key})

def command(browser,path,body,command_key):
    return browser.call(path,body,headers={"Idempotency-Key":command_key})

checks=[]
running=set(compose("ps","--status","running","--services",capture=True).stdout.split())
check("p06-topology-running",{"api","outbox-publisher","payment-worker-a","payment-worker-b"}.issubset(running))

payer=Browser();payer_identity=payer.register_login("P06 payer")
recipient=Browser();recipient_identity=recipient.register_login("P06 recipient")
outsider=Browser();outsider.register_login("P06 outsider")
admin=Browser();admin_identity=admin.login("admin@example.test",VALUES["LEDGER_DEMO_PASSWORD"])
check("p06-identities-ready",payer_identity["role"]=="CUSTOMER" and recipient_identity["role"]=="CUSTOMER" and admin_identity["role"]=="ADMIN")
source=account(payer,"P06 payer wallet");destination=account(recipient,"P06 recipient wallet")
fund(source["id"],20000)
check("p06-balanced-fixture-funded",payer.call("/accounts/"+source["id"])[1]["postedMinor"]=="20000")

# Force two payments to remain PENDING so cancellation can race only with durable queued work.
compose("stop","outbox-publisher","payment-worker-a","payment-worker-b")
status,pending,_=payment(payer,source["id"],destination["publicRef"],2500,key("p06-cancel-payment"))
check("payer-cancellation-payment-accepted",status==202 and pending["state"]=="PENDING")
status,_,_=command(recipient,f"/payments/{pending['id']}/cancel",{},key("p06-recipient-cancel"))
check("recipient-cannot-cancel",status==404)
cancel_key=key("p06-payer-cancel")
status,cancelled,headers=command(payer,f"/payments/{pending['id']}/cancel",{},cancel_key)
status2,cancelled2,headers2=command(payer,f"/payments/{pending['id']}/cancel",{},cancel_key)
check("payer-cancellation-and-replay",status==200 and status2==200 and cancelled==cancelled2 and headers2.get("Idempotency-Replayed",headers2.get("Idempotency-replayed","")).lower()=="true")
check("cancellation-releases-once-without-journal",sql(f"SELECT (SELECT state FROM ledger.payments WHERE id='{pending['id']}')||':'||(SELECT state FROM ledger.holds WHERE payment_id='{pending['id']}')||':'||(SELECT count(*) FROM ledger.journals WHERE operation_id='{pending['id']}')") == "CANCELLED:RELEASED:0")

status,admin_pending,_=payment(payer,source["id"],destination["publicRef"],400,key("p06-admin-cancel-payment"))
check("admin-cancellation-payment-accepted",status==202)
status,_,_=command(admin,f"/payments/{admin_pending['id']}/cancel",{},key("p06-admin-cancel-no-reason"))
check("admin-cancellation-requires-reason",status==403)
status,_,_=command(admin,f"/payments/{admin_pending['id']}/cancel",{"reason":"  operator review  "},key("p06-admin-cancel"))
check("admin-cancellation-with-reason",status==200 and sql(f"SELECT count(*) FROM ledger.audit_records WHERE aggregate_id='{admin_pending['id']}' AND action='CANCEL' AND canonical_body LIKE '%operator review%'")=="1")
compose("up","-d","outbox-publisher","payment-worker-a","payment-worker-b")
wait_sql(f"SELECT count(*) FROM ledger.consumer_inbox i JOIN ledger.outbox_events e ON e.id=i.event_id WHERE i.consumer='payment-settler-v1' AND e.aggregate_id='{pending['id']}' AND e.event_type='payment.requested'","1")
check("cancelled-delivery-cannot-settle",sql(f"SELECT count(*) FROM ledger.journals WHERE operation_id IN ('{pending['id']}','{admin_pending['id']}')")=="0")

# Recipient-authorized partial and full compensating refunds.
status,settlement,_=payment(payer,source["id"],destination["publicRef"],5000,key("p06-refund-payment"))
check("refund-parent-accepted",status==202)
settled=wait_payment(payer,settlement["id"],"SETTLED")
settlement_journal=settled["journalId"]
status,_,_=command(payer,f"/payments/{settlement['id']}/refunds",{"amountMinor":"100"},key("p06-payer-refund"))
check("payer-cannot-refund-own-payment",status==403)
status,_,_=outsider.call(f"/payments/{settlement['id']}/adjustments")
check("outsider-cannot-enumerate-adjustments",status==404)
refund_key=key("p06-partial-refund")
status,partial,headers=command(recipient,f"/payments/{settlement['id']}/refunds",{"amountMinor":"2000","reason":"  partial return  "},refund_key)
status2,partial2,headers2=command(recipient,f"/payments/{settlement['id']}/refunds",{"reason":"partial return","amountMinor":"2000"},refund_key)
check("partial-refund-and-replay",status==201 and status2==201 and partial==partial2 and headers2.get("Idempotency-Replayed",headers2.get("Idempotency-replayed","")).lower()=="true")
status,conflict,_=command(recipient,f"/payments/{settlement['id']}/refunds",{"amountMinor":"2001","reason":"partial return"},refund_key)
check("refund-intent-conflict",status==409 and conflict["code"]=="IDEMPOTENCY_CONFLICT")
check("partial-adjustment-state",payer.call("/payments/"+settlement["id"])[1]["adjustmentState"]=="PARTIALLY_REFUNDED")
status,final_refund,_=command(recipient,f"/payments/{settlement['id']}/refunds",{"amountMinor":"3000","reason":"final return"},key("p06-full-refund"))
check("full-refund-committed",status==201 and payer.call("/payments/"+settlement["id"])[1]["adjustmentState"]=="FULLY_REFUNDED")
status,adjustments,_=payer.call(f"/payments/{settlement['id']}/adjustments?limit=1&offset=0")
status2,detail,_=payer.call(f"/payments/{settlement['id']}/adjustments/{partial['id']}")
check("adjustment-history-and-detail",status==200 and adjustments["hasMore"] is True and status2==200 and detail["kind"]=="REFUND")
check("original-settlement-journal-preserved",sql(f"SELECT count(*) FROM ledger.journal_entries WHERE journal_id='{settlement_journal}'")=="2" and sql(f"SELECT count(*) FROM ledger.adjustments WHERE payment_id='{settlement['id']}'")=="2")
check("full-refund-restores-economics",sql(f"SELECT posted_minor FROM ledger.account_balances WHERE account_id='{source['id']}'")=="20000" and sql(f"SELECT posted_minor FROM ledger.account_balances WHERE account_id='{destination['id']}'")=="0")

# ADMIN full reversal is a distinct, one-time compensating posting.
status,reversal_parent,_=payment(payer,source["id"],destination["publicRef"],3000,key("p06-reversal-payment"))
check("reversal-parent-accepted",status==202)
wait_payment(payer,reversal_parent["id"],"SETTLED")
status,_,_=command(recipient,f"/payments/{reversal_parent['id']}/reversal",{"reason":"not authorized"},key("p06-recipient-reversal"))
check("recipient-cannot-reverse",status==403)
status,_,_=command(admin,f"/payments/{reversal_parent['id']}/reversal",{"reason":"   "},key("p06-blank-reversal"))
check("reversal-reason-required",status==400)
reverse_key=key("p06-admin-reversal")
status,reversed,headers=command(admin,f"/payments/{reversal_parent['id']}/reversal",{"reason":"  duplicate settlement correction  "},reverse_key)
status2,reversed2,headers2=command(admin,f"/payments/{reversal_parent['id']}/reversal",{"reason":"duplicate settlement correction"},reverse_key)
check("admin-reversal-and-replay",status==201 and status2==201 and reversed==reversed2 and headers2.get("Idempotency-Replayed",headers2.get("Idempotency-replayed","")).lower()=="true")
current=payer.call("/payments/"+reversal_parent["id"])[1]
check("reversal-keeps-base-settled",current["state"]=="SETTLED" and current["adjustmentState"]=="REVERSED")
status,blocked_refund,_=command(recipient,f"/payments/{reversal_parent['id']}/refunds",{"amountMinor":"1"},key("p06-refund-after-reversal"))
status2,blocked_reversal,_=command(admin,f"/payments/{reversal_parent['id']}/reversal",{"reason":"again"},key("p06-second-reversal"))
check("forbidden-post-reversal-transitions",status==409 and status2==409)
check("reversal-restores-original-balances",sql(f"SELECT posted_minor FROM ledger.account_balances WHERE account_id='{source['id']}'")=="20000" and sql(f"SELECT posted_minor FROM ledger.account_balances WHERE account_id='{destination['id']}'")=="0")
check("reversal-is-single-immutable-adjustment",sql(f"SELECT count(*) FROM ledger.adjustments WHERE payment_id='{reversal_parent['id']}' AND kind='REVERSAL'")=="1" and sql(f"SELECT count(*) FROM ledger.audit_records WHERE aggregate_id='{reversal_parent['id']}' AND action='REVERSAL'")=="1")

check("p06-eight-migrations",sql("SELECT count(*) FROM public.flyway_schema_history WHERE success") == "8")
check("p06-deferred-adjustment-trigger-installed",sql("SELECT count(*) FROM pg_trigger WHERE tgname='adjustment_posting_consistent' AND tgdeferrable") == "1")
check("p06-adjustment-accounting-reconciles",sql("SELECT count(*) FROM ledger.account_balances b JOIN ledger.accounts a ON a.id=b.account_id WHERE b.posted_minor::numeric<>(SELECT coalesce(sum(CASE WHEN a.kind='WALLET_LIABILITY' THEN CASE WHEN e.side='CREDIT' THEN e.amount_minor::numeric ELSE -e.amount_minor::numeric END ELSE CASE WHEN e.side='DEBIT' THEN e.amount_minor::numeric ELSE -e.amount_minor::numeric END END),0) FROM ledger.journal_entries e WHERE e.account_id=a.id)") == "0")

report={"sourceSha":subprocess.check_output(["git","rev-parse","HEAD"],cwd=ROOT,text=True).strip(),
        "timestamp":datetime.now(timezone.utc).isoformat(),
        "scope":"real Docker Compose P06 cancellation/refund/reversal/idempotency/authorization/accounting smoke",
        "checks":checks}
out=ROOT/".evidence/payment-adjustment-compose";out.mkdir(parents=True,exist_ok=True)
(out/"results.json").write_text(json.dumps(report,indent=2)+"\n")
print(json.dumps(report,indent=2))
