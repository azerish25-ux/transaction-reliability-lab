  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "LEDGER_SESSION"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "recipientRef",
          "amountMinor",
          "currency",
          "intendedLocal",
          "zoneId",
          "recurrence",
          "version",
          "eventVersion",
          "nextInstant",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "recipientRef": {
            "type": "string",
            "pattern": "^LG-[0-9a-f]{32}$"
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,12}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CAD",
              "USD",
              "JPY",
              "KWD"
            ]
          },
          "intendedLocal": {
            "type": "string",
            "format": "date-time",
            "description": "IANA-zone wall time without an offset"
          },
          "zoneId": {
            "type": "string",
            "examples": [
              "America/Halifax",
              "UTC"
            ]
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "ONCE",
              "DAILY",
              "WEEKLY"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "eventVersion": {
            "type": "integer",
            "minimum": 1
          },
          "nextInstant": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "CANCELLED",
              "FINISHED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScheduleDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "recipientRef",
          "amountMinor",
          "currency",
          "intendedLocal",
          "zoneId",
          "recurrence"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "recipientRef": {
            "type": "string",
            "pattern": "^LG-[0-9a-f]{32}$"
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,12}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CAD",
              "USD",
              "JPY",
              "KWD"
            ]
          },
          "intendedLocal": {
            "type": "string",
            "format": "date-time",
            "description": "IANA-zone wall time without an offset"
          },
          "zoneId": {
            "type": "string",
            "examples": [
              "America/Halifax",
              "UTC"
            ]
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "ONCE",
              "DAILY",
              "WEEKLY"
            ]
          }
        }
      },
      "EditSchedule": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScheduleDefinition"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expectedVersion"
            ],
            "properties": {
              "expectedVersion": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "VersionCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ScheduleOccurrence": {
        "type": "object",
        "required": [
          "id",
          "scheduleId",
          "scheduleVersion",
          "intendedLocal",
          "dueAt",
          "outcome",
          "operationId",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scheduleId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduleVersion": {
            "type": "integer",
            "minimum": 1
          },
          "intendedLocal": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "REJECTED",
              "SKIPPED_LATE"
            ]
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "journalId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SchedulePage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Schedule"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "OccurrencePage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleOccurrence"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  }
