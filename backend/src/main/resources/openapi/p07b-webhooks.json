          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "CreateWebhookEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destinationId"
        ],
        "properties": {
