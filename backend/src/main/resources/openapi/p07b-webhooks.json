    "/events": {
      "post": {
        "summary": "Internal sandbox receiver contract",
        "description": "The sender transmits the exact JSON bytes used in the HMAC. Signed bytes are ASCII(timestamp) + '.' + ASCII(event UUID) + '.' + raw body. The receiver accepts timestamps within 300 seconds, validates the key version and compares v1 HMAC-SHA256 in constant time. Repeated endpoint/event identities are recorded as duplicate receipts without another receiver-side effect.",
        "parameters": [
          {
            "name": "X-LedgerGuard-Endpoint-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-LedgerGuard-Event-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-LedgerGuard-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-LedgerGuard-Key-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-LedgerGuard-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^v1=[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted or duplicate accepted receipt"
          },
          "400": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Controlled sandbox retry response"
          },
          "503": {
            "description": "Controlled sandbox retry/response-loss response"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "LG-SESSION"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId",
          "validation"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "validation": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": [
          "id",
          "ownerId",
          "destinationId",
          "destinationUrl",
          "enabled",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationId": {
            "type": "string",
            "enum": [
              "sandbox-receiver"
            ]
          },
          "destinationUrl": {
            "type": "string",
            "enum": [
              "http://receiver:8081/events"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rotatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "WebhookEndpointSecret": {
        "type": "object",
        "required": [
          "endpoint",
          "signingSecret"
        ],
        "properties": {
          "endpoint": {
            "$ref": "#/components/schemas/WebhookEndpoint"
          },
          "signingSecret": {
            "type": "string",
            "description": "One-time URL-safe base64 secret returned only by creation or explicit rotation.",
            "minLength": 43,
            "maxLength": 43
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "required": [
          "id",
          "endpointId",
          "ownerId",
          "destinationId",
          "eventId",
          "eventType",
          "state",
          "cycle",
          "attempts",
          "totalAttempts",
          "nextAttemptAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "endpointId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationId": {
            "type": "string",
            "enum": [
              "sandbox-receiver"
            ]
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_FLIGHT",
              "DELIVERED",
              "FAILED"
            ]
          },
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "totalAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      },
      "WebhookAttempt": {
        "type": "object",
        "required": [
          "cycle",
          "attempt",
          "attemptedAt",
          "outcome",
          "durationMs"
        ],
        "properties": {
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "attemptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestTimestamp": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "secretKeyVersion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "outcome": {
            "type": "string",
            "enum": [
              "DELIVERED",
              "RETRY_SCHEDULED",
              "PERMANENT_FAILURE",
              "EXHAUSTED",
              "LEASE_EXPIRED"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "responseSummary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "nextAttemptAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "WebhookDeliveryDetail": {
