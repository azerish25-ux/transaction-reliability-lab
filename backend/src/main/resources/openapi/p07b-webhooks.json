        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
