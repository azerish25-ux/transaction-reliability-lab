# Compose validation placeholders only. ./scripts/lab up creates private random runtime values.
# Do not run a deployment using this file.
COMPOSE_PROJECT_NAME=ledgerguard
POSTGRES_DB=ledgerguard
POSTGRES_SUPERUSER_PASSWORD=validation-placeholder-not-a-password
LEDGER_OWNER_PASSWORD=validation-placeholder-not-a-password
LEDGER_RUNTIME_PASSWORD=validation-placeholder-not-a-password
RABBITMQ_DEFAULT_USER=ledgerguard
RABBITMQ_DEFAULT_PASS=validation-placeholder-not-a-password
RABBITMQ_DEFAULT_VHOST=/ledgerguard
LEDGER_AUTH_KEY=validation-placeholder-not-a-signing-key
LEDGER_DEMO_PASSWORD=validation-placeholder-not-a-password
LEDGER_HTTP_PORT=8080
LEDGER_RABBIT_MANAGEMENT_PORT=15672
